{
  "name": "python3-node24-arm64",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "containerEnv": {
    "PDM_VENV_IN_PROJECT": "1",
    "PDM_IGNORE_SAVED_PYTHON": "1",
    "DISABLE_AUTOUPDATER": "1",
    "INSTALL_AGENTS": "${templateOption:agents}"
  },
  "initializeCommand": [
    "bash",
    "${localWorkspaceFolder}/.devcontainer/initialize.sh",
    "${localWorkspaceFolder}",
    "${templateOption:agents}"
  ],
  "runArgs": [
    "--env-file",
    "${localWorkspaceFolder}/.devcontainer/.env"
  ],
  // isolate the devcontainer virtualenv from the host workspace .venv (e.g. macos host with linux container)
  "mounts": [
    "source=${devcontainerId}-venv,target=${containerWorkspaceFolder}/.venv,type=volume,volume-nocopy"
  ],
  "remoteUser": "vscode",
  "remoteEnv": {
    "CLAUDE_CONFIG_DIR": "${containerWorkspaceFolder}/.devcontainer/.claude",
    "CODEX_HOME": "${containerWorkspaceFolder}/.devcontainer/.codex"
  },
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "24",
      "npmVersion": "latest"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "tamasfe.even-better-toml",
        "anthropic.claude-code",
        "openai.chatgpt",
        "MermaidChart.vscode-mermaid-chart"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv",
        "editor.formatOnPaste": true,
        "editor.formatOnSave": true,
        "files.insertFinalNewline": true,
        "files.trimFinalNewlines": true,
        "editor.autoIndent": "full",
        "workbench.editor.restoreViewState": true,
        "terminal.integrated.copyOnSelection": true,
        "terminal.integrated.hideOnStartup": "always",
        "editor.pasteAs.preferences": [
          "text.updateImports"
        ],
        "js/ts.tsdk.promptToUseWorkspaceVersion": true,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit",
          "source.organizeImports": "never",
          "source.sortMembers": "explicit"
        },
        "search.exclude": {
          "**/node_modules": true,
          "**/__pycache__": true,
          "**/.pytest_cache": true,
          "**/.mypy_cache": true,
          "**/.ruff_cache": true,
          "**/.tox": true,
          "**/.nox": true,
          "**/.venv": true,
          "**/venv": true,
          "**/.yarn": true,
          "**/.pnp.*": true
        },
        "chat.disableAIFeatures": true,
        "github.copilot.editor.enableAutoCompletions": true,
        "github.copilot.advanced": {},
        "github.copilot.chat.startDebugging.enabled": false,
        "github.copilot.editor.enableCodeActions": false,
        "notifications.silent": {
          "GitHub.copilot": true,
          "GitHub.copilot-chat": true
        }
      }
    }
  },
  "postCreateCommand": "bash \"${containerWorkspaceFolder}/.devcontainer/post_create.sh\"",
  "postStartCommand": "bash \"${containerWorkspaceFolder}/.devcontainer/restore_links.sh\"",
  "forwardPorts": [1455, 1457],
  "portsAttributes": {
    "1455": {
      "label": "Codex Login",
      "requireLocalPort": false
    },
    "1457": {
      "label": "Codex Login (fallback)",
      "requireLocalPort": false
    }
  }
}
